BOT_TOKEN=1234567890:AAGHx...
REMNAWAVE_BASE_URL=https://panel.blabla.ru
REMNAWAVE_TOKEN=eyJhbGciOiJIUzI1NiIs...
# always — прямое HTTPS к панели (VPS); auto — если перед панелью nginx/caddy с x-forwarded-*
REMNAWAVE_PROXY_HEADERS=always
# JSON-куки для панели — только если Remnawave ставили скриптом egames; иначе {}
COOKIES={}
SUPPORT_URL=https://t.me/username
# Юзернейм или почта для политики/оферты. Группа (t.me/+) для Platega не подходит.
SUPPORT_CONTACT=@username
MINI_APP_URL=https://your-domain.com
# Origin сайта (без /app). WebApp / Menu Button → автоматически …/app
# Callback Platega / OAuth /privacy строятся от origin.
# Cabinet shell: React Vite SPA. Локально нужен собранный mini_app/static/cabinet/
# (cd mini_app/frontend && npm ci && npm run build). В Docker собирает Node stage.
# Нет dist — GET /app отвечает 503.
# Опционально: канал по умолчанию, если не задан в админке (Настройки → Канал)
# REQUIRED_CHANNEL=@your_channel
# Числовой Telegram ID owner (несменяемый). Остальные админы — Mini App → Админы
PAYMENT_CHAT_ID=123456789
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Optional fallbacks for other PSPs (active provider set in Mini App admin)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
WATA_ACCESS_TOKEN=
WATA_SANDBOX=false
# Pally (Pal24) — API token + shop_id; postback → /api/payments/callback/pally
PALLY_API_TOKEN=
PALLY_SHOP_ID=
PAYMENT_AMOUNT=300
PAYMENT_DAYS=30
# AI support (FRV-92): fallback LLM key when not set in Mini App admin
SUPPORT_AI_API_KEY=
# Как часто синхронизировать срок LTE-близнеца с основным (мин; ручные продления в панели)
TWIN_SYNC_INTERVAL_MIN=30

# --- PostgreSQL 18 (required) ---
POSTGRES_USER=frvrsd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=frvrsd
# Compose: host = postgres. Local/systemd: 127.0.0.1
DATABASE_URL=postgresql://frvrsd:change-me@postgres:5432/frvrsd
# Tests: DATABASE_URL=postgresql://frvrsd:change-me@127.0.0.1:5432/frvrsd_test

# S3 / S3-compatible (fallback; основная настройка — в админке Mini App → S3)
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION=ru-central1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=frvrsd-db
# S3_SUPPORT_PREFIX=frvrsd-support
# S3_BACKUP_INTERVAL_HOURS=24
# S3_BACKUP_KEEP_COUNT=14
# S3_FORCE_PATH_STYLE=true
# Local fallback for support images when S3 is not set (docker volume OK)
# SUPPORT_MEDIA_DIR=data/support-media

# DEV-only: open Mini App in a normal browser (no Telegram WebApp / initData).
# Frontend-only (no Remnawave): cp .env.dev.example .env && ./scripts/run_dev_miniapp.sh
# Never enable on production. Requires a non-empty secret.
# Auth accepted only from localhost; secret is prompted in the browser (not in HTML).
# DEV_AUTH_ENABLED=true
# DEV_AUTH_SECRET=local-dev-secret
# DEV_FIXTURES=true
# Optional when fixtures=false: real tg_id of a panel user for role=customer
# DEV_AUTH_CUSTOMER_TG_ID=

# --- Vendor license (ADR 0003). Default LICENSE_ENFORCE=true: shop stays
# closed until LICENSE_KEY succeeds at least once (signed valid/activated).
# Release Docker image: license server URL + RSA public PEM are baked into
# sealed bot.license (https://license.frvrsd.shop + deploy/vendor_license_public.pem).
# Operator first-run: Mini App admin form — key only (Админка → Настройки → Лицензия).
# Local/dev: set URL + PEM via env; LICENSE_ENFORCE=false skips only with DEV_AUTH/pytest.
# LICENSE_ENFORCE=false
# LICENSE_KEY=FRV-...
# LICENSE_SERVER_URL=https://license.frvrsd.shop
# LICENSE_PUBLIC_KEY=
# LICENSE_PUBLIC_KEY_PATH=
# Heartbeat is every 30 minutes and grace is 3 days. Both are constants in
# bot.license — not operator settings.
# Persistent fingerprint when /etc/machine-id is missing (Docker without the host bind).
# LICENSE_INSTANCE_ID_PATH=data/instance-id
# Linux compose: mount host /etc/machine-id:/etc/machine-id:ro on the bot service when possible.

# --- Docker Compose (./install.sh) ---
# frvrsd update заменяет значение на последний тег x.y.z с Docker Hub.
FRVRSD_IMAGE=frvrsd/frvrsd_vpn_bot:1.0.0
# Optional override of the version baked into the Docker image (semver, no leading v).
# Prefer baking via ./scripts/docker-build.sh vX.Y.Z — do not set empty APP_VERSION=
# in .env (that would clear the image value and trip min_version force-update).
# APP_VERSION=1.2.3
# Домен для Caddy (--https); можно не задавать — install.sh возьмёт из MINI_APP_URL
MINI_APP_DOMAIN=

# --- xray-checker (optional compose profile) ---
# Enable: COMPOSE_PROFILES=https,xray-checker  or  frvrsd xray-checker on
# Probe subscription URL (panel user with all needed outbounds / squads).
# XRAY_CHECKER_SUBSCRIPTION_URL=https://panel.example/api/sub/xxxxxxxx
# Remnawave balancers: request JSON and check each outbound (default true in compose).
# XRAY_CHECKER_SUBSCRIPTION_JSON_FORMAT=true
# Same URL (+ UA) for miniapp: dedupe Servers rows by host:port across groups.
# XRAY_CHECKER_SUBSCRIPTION_USER_AGENT=
# XRAY_CHECKER_URL=http://xray-checker:2112
# XRAY_CHECKER_USERNAME=checker
# XRAY_CHECKER_PASSWORD=
# XRAY_CHECKER_METRICS_PROTECTED=true
# XRAY_CHECKER_PROXY_CHECK_INTERVAL=300
# XRAY_CHECKER_SUBSCRIPTION_UPDATE_INTERVAL=300
